# =============================================================================
# Presença+ — variáveis de ambiente do aplicativo
# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Painel do Supabase > Project Settings > API).
# =============================================================================

# URL do projeto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable). É segura no app SOMENTE porque todas as
# tabelas possuem Row Level Security. NUNCA coloque a service_role key aqui.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# (Opcional) ID do projeto EAS — necessário apenas para notificações push remotas
# em development build / APK. Obtido com: npx eas-cli@latest init
EXPO_PUBLIC_EAS_PROJECT_ID=
